{
  "name": "@sitedesk/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run build:mock && playwright test",
    "build:mock": "VITE_USE_MOCKS=1 vite build",
    "build:live": "vite build",
    "integration": "npm run build:live && playwright test -c playwright.integration.config.ts"
  },
  "dependencies": {
    "@sitedesk/contracts": "*",
    "@sitedesk/ui": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "msw": "^2.15.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
