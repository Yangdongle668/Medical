# 部署配置。deploy.sh 会据此生成 deploy/.env（口令随机生成），
# 生成之后就**不要**再让它进版本库 —— .gitignore 已经挡了。

# 对外端口。前面通常还有一层做 TLS 的 ingress，那时这里可以只绑内网。
SITEDESK_PORT=8080

# 台的公开地址。签发登录链接时用它拼 URL；填错了，链接点开会落到别处。
SITEDESK_PUBLIC_ORIGIN=http://localhost:8080

# 镜像标签。update.sh 每次改成新的 git 短 sha —— 旧标签留着，
# 回滚就是把它改回去再 `docker compose up -d`。
SITEDESK_TAG=local

# 数据库口令。deploy.sh 生成，之后不要手改：
# 改了这里而不改库里的口令，服务会连不上，而报错只会说认证失败。
POSTGRES_DB=sitedesk
POSTGRES_PASSWORD=
SITEDESK_DB_OWNER_PASSWORD=
SITEDESK_DB_APP_PASSWORD=

# 收到 SIGTERM 之后、真正关门之前等多久（毫秒）。
# **必须比负载均衡的探测间隔长**，否则每次发布都会漏掉一小撮请求。
SITEDESK_DRAIN_MS=5000

# info / debug。debug 会把静态产物与探针的访问日志也打出来。
SITEDESK_LOG_LEVEL=info
