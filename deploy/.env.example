# 部署配置。deploy.sh 会据此生成 deploy/.env（口令随机生成），
# 生成之后就**不要**再让它进版本库 —— .gitignore 已经挡了。

# 对外端口。前面通常还有一层做 TLS 的 ingress，那时这里可以只绑内网。
SITEDESK_PORT=8080

# 台的公开地址。签发登录链接时用它拼 URL；填错了，链接点开会落到别处。
SITEDESK_PUBLIC_ORIGIN=http://localhost:8080

# 镜像标签。update.sh 每次改成新的 git 短 sha —— 旧标签留着，
# 回滚就是把它改回去再 `docker compose up -d`。
SITEDESK_TAG=local

# 数据库口令。deploy.sh 生成，之后不要手改：
# 改了这里而不改库里的口令，服务会连不上，而报错只会说认证失败。
POSTGRES_DB=sitedesk
POSTGRES_PASSWORD=
SITEDESK_DB_OWNER_PASSWORD=
SITEDESK_DB_APP_PASSWORD=

# ── 排空：收到 SIGTERM 之后、真正关门之前等多久 ───────────────────
# 它必须比「负载均衡把本实例摘掉」所需的时间长，也就是
#   探测间隔 × 连续失败阈值 + 一点余量
# k8s 默认 10s × 3 = 30 秒；ALB 默认 30s × 2 = 60 秒。短了不会报错，
# 只会让每次发布漏掉一小撮请求（客户端那头看到连接被拒）。
#
# 两种填法，二选一。都不填的话按 5000 跑，并在启动日志里告警一次。
# SITEDESK_DRAIN_MS=30000
#
# 不知道该填几秒？填 LB 的探测间隔，剩下的让进程自己算：
# SITEDESK_LB_PROBE_MS=10000
# SITEDESK_LB_PROBE_FAILURES=3

# ── 登录链接的投递通道 ────────────────────────────────────────────
# 不配的话链接照样签发，但没有人收得到 —— 只能由能进服务器的人跑
# ./deploy/login-link.sh 代发，也就是签发权限等同于运维权限。
#
# 邮件（口令里有 @ : / 之类要按 URL 编码）：
# SITEDESK_SMTP_URL=smtp://用户名:口令@smtp.example.com:587
# SITEDESK_MAIL_FROM=中心台 <no-reply@example.com>
#
# 短信：往网关 POST 一个 {"to","text"} 的 JSON，Bearer 鉴权。
# 字段名对不上时，中间摆一个十行的适配器，不必改这个进程。
# SITEDESK_SMS_WEBHOOK_URL=https://sms.example.com/send
# SITEDESK_SMS_WEBHOOK_TOKEN=

# ── TLS ───────────────────────────────────────────────────────────
# 握手归前面那层 ingress。这两个是它做不了的部分，**默认关**：
#
# HSTS **默认就开**（max-age 两年）。它只在这次请求确实经 TLS 到达时才发出
# （看 X-Forwarded-Proto 的最左段），所以纯 http 的部署根本走不到那一行。
# 想关掉就显式写 0：
# SITEDESK_HSTS_MAX_AGE=0
#
# includeSubDomains 是 opt-in：它锁的是这套部署**并不拥有**的那些子域名，
# 是 HSTS 里唯一会误伤别人、且无法回滚的部分。确认所有子域名都有证书再开。
# SITEDESK_HSTS_INCLUDE_SUBDOMAINS=1
# SITEDESK_HSTS_PRELOAD=1
#
# 强制 https **默认关**，而且应该保持关着，除非你确定前面有 TLS：
# 它把明文请求 308 走 —— 纯 http 的部署会当场变得打不开。
# SITEDESK_FORCE_HTTPS=1

# info / debug。debug 会把静态产物与探针的访问日志也打出来。
SITEDESK_LOG_LEVEL=info
