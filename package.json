{
  "name": "sitedesk",
  "private": true,
  "version": "0.1.0",
  "description": "临床中心台 SiteDesk — CRO/SMO 运营管理系统",
  "workspaces": [
    "db",
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "npm run migrate:up -w db",
    "db:down": "npm run migrate:down -w db",
    "db:reset": "npm run reset -w db",
    "db:seed": "npm run seed -w db",
    "contracts:build": "npm run build -w @sitedesk/contracts",
    "contracts:check": "npm run check:breaking -w @sitedesk/contracts",
    "typecheck": "npm run typecheck -w @sitedesk/contracts",
    "test": "npm run test -w db && npm run test -w @sitedesk/contracts"
  }
}
